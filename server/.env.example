# Claude API key (or run `ant auth login` instead)
ANTHROPIC_API_KEY=

# Signs the session cookie; set a long random value outside local development
SESSION_SECRET=dev-only-secret-change-me

PORT=8787
APP_URL=http://localhost:5173

# One reminder "day" in milliseconds. 60000 = watch reminders fire every minute while developing.
# REMINDER_UNIT_MS=60000
