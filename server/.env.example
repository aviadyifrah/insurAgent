# Claude API key. In production it comes from Secret Manager (firebase functions:secrets:set ANTHROPIC_API_KEY)
ANTHROPIC_API_KEY=

# Local development runs against the Firebase emulators (npm run dev starts them)
GCLOUD_PROJECT=demo-insuragent
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

PORT=8787
APP_URL=http://localhost:5173

# New users must enter this code (in production: firebase functions:secrets:set ACCESS_CODE)
# ACCESS_CODE=

# One reminder "day" in milliseconds. 60000 = watch reminders fire every minute while developing.
# REMINDER_UNIT_MS=60000

# Daily limits (defaults: 30 messages / 20 uploads per user, 300 / 200 across all users)
# DAILY_MESSAGE_LIMIT=30
# DAILY_UPLOAD_LIMIT=20

# Claims per user in the trial (default 1)
# FREE_CLAIM_LIMIT=1
