# Settings for the deployed Cloud Functions (not secrets; committed). Copied into deploy/.env on build.
# Link used in reminders.
APP_URL=https://insuragent-il.web.app

# Daily limits on what costs model calls, per user and across all users (Israel calendar day).
DAILY_MESSAGE_LIMIT=30
DAILY_UPLOAD_LIMIT=20
GLOBAL_DAILY_MESSAGE_LIMIT=300
GLOBAL_DAILY_UPLOAD_LIMIT=200

# Optional: require this code from new users at first sign-in. Empty = open sign-up.
ACCESS_CODE=

# Trial: claims each user may open. A claim_limit field on a user's Firestore document overrides this.
FREE_CLAIM_LIMIT=1

# Who can open the admin screen (#/admin), comma-separated Google account emails.
ADMIN_EMAILS=aviad.yifrah@gmail.com

# Model that reads uploaded documents first (weak reads escalate to Opus automatically).
EXTRACT_MODEL=claude-haiku-5-5

# Phone notifications (web push): the public key from Firebase Console > Project settings >
# Cloud Messaging > Web Push certificates. Empty = the notification button is hidden.
WEB_PUSH_VAPID_KEY=BKbafTBufk2BR6sqRdBuRie9QtdEFfoDBOIylr7g8XCXR0DojpgZ138Tnqx8FG9QrgSv6B1A2GaD93llBbd0q0Y

# Sign-in SMS caps (each SMS to Israel costs $0.20; the first 10 a day are free). Enforced by the
# smsGuard blocking function, which needs Identity Platform: set SMS_GUARD=on once the project is upgraded.
SMS_GUARD=off
SMS_DAILY_LIMIT=30
SMS_PER_NUMBER_DAILY_LIMIT=5
# Alert the admins (phone notification + Error Reporting) when today's count reaches this.
SMS_ALERT_AT=10
