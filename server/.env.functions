# Settings for the deployed Cloud Functions (not secrets; committed). Copied into deploy/.env on build.
# Link used in reminders.
APP_URL=https://insuragent-il.web.app

# Daily limits on what costs model calls, per user and across all users (Israel calendar day).
DAILY_MESSAGE_LIMIT=30
DAILY_UPLOAD_LIMIT=20
GLOBAL_DAILY_MESSAGE_LIMIT=300
GLOBAL_DAILY_UPLOAD_LIMIT=200

# Optional: require this code from new users at first sign-in. Empty = open sign-up.
ACCESS_CODE=

# Trial: claims each user may open. A claim_limit field on a user's Firestore document overrides this.
FREE_CLAIM_LIMIT=1
