rules_version = '2';

// Clients only read their own data (live updates in the app). Every write goes through the
// server, which uses the Admin SDK and is not subject to these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(data) {
      return request.auth != null && data.user_id == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    match /claims/{claimId} {
      allow read: if isOwner(resource.data);

      // Only what the claim screen shows. Raw model turns and the agent inbox stay server-side.
      match /{sub}/{docId} {
        allow read: if sub in ["requirements", "tasks", "emails", "chat"] && isOwner(resource.data);
      }
    }

    match /documents/{docId} {
      allow read: if isOwner(resource.data);
    }
  }
}
